[cynox-project-stable]
name=Cynox Project Repository (stable)
baseurl=https://rpm.cynox-project.org/stable/noarch
gpgcheck=1
repo_gpgcheck=1
enabled=1
gpgkey=file:///etc/pki/rpm-gpg/GPG-Cynox-Project

[cynox-project-beta]
name=Cynox Project Repository (beta)
baseurl=https://rpm.cynox-project.org/beta/noarch
gpgcheck=1
repo_gpgcheck=1
enabled=0
gpgkey=file:///etc/pki/rpm-gpg/GPG-Cynox-Project
